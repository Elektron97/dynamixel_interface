<launch>

  <!--
    command_mode: "current" | "turns" | "current_position"
      current           -> commands motors by current [A] on /dynamixels/cmd_currents
                            (also accepts torque [Nm] on /dynamixels/cmd_torques)
      turns             -> commands motors by turn count on /dynamixels/cmd_turns, no torque ceiling
      current_position  -> commands turns like above, but caps the position controller's
                            torque at current_limit (see below) - use this on a tendon-driven
                            robot to avoid overtensioning on contact/stall
  -->
  <arg name="command_mode"  default="current"/>

  <!--
    current_limit [A]: torque ceiling for command_mode="current_position", written once at
    startup as Goal Current. Ignored in the other two modes. Keep this at or below the
    servo's rated MAX_CURRENT (3.209 A for the XM430-W210).
  -->
  <arg name="current_limit" default="1.5"/>

  <!--
    max_turns: cap on the magnitude of a commanded turn count for
    command_mode="turns"|"current_position" (ignored in "current"). Defaults to
    MAX_TURNS (dynamixel_utils.h) if unset.
  -->
  <arg name="max_turns" default="3.0"/>

  <!--
    profile_velocity / profile_acceleration: raw Profile Velocity / Profile Acceleration
    register values (control table addresses 112/108), written once per motor at
    startup regardless of command_mode - they shape the trapezoidal motion profile
    used by the position controller (higher = faster/more abrupt moves). Default to
    PROFILE_VEL_VALUE/PROFILE_ACC_VALUE (dynamixel_utils.h) if unset.
  -->
  <arg name="profile_velocity"     default="100"/>
  <arg name="profile_acceleration" default="10"/>

  <node name="motor_io" pkg="dynamixel_interface" type="motor_io" output="screen">
    <param name="command_mode"          value="$(arg command_mode)"/>
    <param name="current_limit"         value="$(arg current_limit)"/>
    <param name="max_turns"             value="$(arg max_turns)"/>
    <param name="profile_velocity"      value="$(arg profile_velocity)"/>
    <param name="profile_acceleration"  value="$(arg profile_acceleration)"/>
  </node>

</launch>
